MODULE    = wineandroid.drv
UNIXLIB   = wineandroid.so
IMPORTS   = ntoskrnl
UNIX_LIBS = -lwin32u $(PTHREAD_LIBS)

# Amphora hosts the Activity itself. Do not build Wine's wine-debug.apk
# (EXTRA_TARGETS + gradle); that target is unused and breaks headless WCP CI.
SOURCES = \
	device.c \
	dllmain.c \
	init.c \
	keyboard.c \
	opengl.c \
	window.c \
	wine.svg
